# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# SUPABASE_URL: Your Supabase project URL (e.g., https://xyz.supabase.co)
SUPABASE_URL=

# SUPABASE_SECRET_KEY: Server-only secret key (used for server-side auth verification & admin database queries)
# NEVER expose this key to the browser / client code!
SUPABASE_SECRET_KEY=

# SUPABASE_PUBLISHABLE_KEY: Client/browser publishable key (optional client-side key)
SUPABASE_PUBLISHABLE_KEY=

# LEGACY SUPABASE KEYS (Supported for backward compatibility if secret key is not set)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# GOOGLE GMAIL OAUTH 2.0 CONFIGURATION (IC-V1.0.4)
# GOOGLE_CLIENT_ID: OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: OAuth 2.0 Web Client Secret (Server-only secret)
GOOGLE_CLIENT_SECRET=

# GOOGLE_REDIRECT_URI: Authorized OAuth redirect URI (e.g., https://your-domain.com/api/connections/gmail/callback)
GOOGLE_REDIRECT_URI=

# GOOGLE_TOKEN_ENCRYPTION_KEY: 32-byte hex/base64 key for AES-256-GCM encryption of stored OAuth tokens
GOOGLE_TOKEN_ENCRYPTION_KEY=

